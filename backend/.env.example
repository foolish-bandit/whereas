# Whereas backend — copy to .env (in this directory) and fill in real
# values. Do not commit the resulting .env file.
#
# This file mirrors the environment variables docker-compose.yml wires
# into the `backend` service, plus the optional settings backend/app/core/
# config.py exposes for running the backend directly on the host. See
# docs/local-developer-quickstart.md for the full walkthrough.

# ---------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------

# Session signing / CSRF. Generate with: openssl rand -hex 32
SECRET_KEY=

# Wraps every org's document-encryption master key. The backend refuses
# to start without this. Must be exactly 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
WHEREAS_INSTANCE_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------

# docker-compose builds this from POSTGRES_USER/POSTGRES_PASSWORD; set it
# directly here if running the backend on the host against the compose
# Postgres (bound on 127.0.0.1:5432).
DATABASE_URL=postgresql+asyncpg://whereas:whereas@localhost:5432/whereas
POSTGRES_USER=whereas
# Generate with: openssl rand -hex 20
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------
# S3 / MinIO (required)
# ---------------------------------------------------------------------

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
# Generate with: openssl rand -hex 20
S3_SECRET_KEY=
S3_BUCKET=whereas-documents
S3_REGION=us-east-1

# docker-compose reads these two to configure the MinIO container itself.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------
# LLM (LiteLLM abstraction — see docs/AI_SMALL_MODEL_STACK.md)
# ---------------------------------------------------------------------

# "ollama" keeps documents on this machine by default (design principle:
# documents never leave the deployment unless explicitly configured
# otherwise). Only change this, and set the matching *_API_KEY below, if
# you intentionally want to use a remote provider via LiteLLM.
LITELLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# <=2B parameters by default so this runs on a single machine without a
# GPU. Larger models (e.g. llama3.1:70b) are opt-in for capable hardware.
EXTRACTION_MODEL=qwen2.5:1.5b
LLM_REQUEST_TIMEOUT_SECONDS=120

# Only needed if LITELLM_PROVIDER points at that provider. Leave unset to
# stay fully local.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=

# ---------------------------------------------------------------------
# DocuSeal (required)
# ---------------------------------------------------------------------

DOCUSEAL_BASE_URL=http://localhost:8081
# Shared secret the auth-bridge uses to mint JWTs DocuSeal accepts.
# Generate with: openssl rand -hex 32
DOCUSEAL_AUTH_BRIDGE_SECRET=
# Rails secret_key_base for the DocuSeal container itself.
# Generate with: openssl rand -hex 64
DOCUSEAL_SECRET_KEY_BASE=
# Optional: verifies DocuSeal completion webhooks. Required in
# non-development environments; see app/services/docuseal_bridge.py.
# Generate with: openssl rand -hex 32
# DOCUSEAL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Extraction confidence thresholds (optional; defaults shown)
# ---------------------------------------------------------------------

EXTRACTION_MIN_CONFIDENCE=0.70
EXTRACTION_DROP_THRESHOLD=0.40

# ---------------------------------------------------------------------
# Nango (third-party integrations bridge; optional — leave the secrets
# unset to disable integrations entirely)
# ---------------------------------------------------------------------

NANGO_BASE_URL=http://localhost:3003
NANGO_PUBLIC_URL=http://localhost:3003
# Generate with: openssl rand -hex 32
# NANGO_SECRET_KEY=
# Generate with: openssl rand -hex 32
# NANGO_WEBHOOK_SECRET=
NANGO_ENABLED_PROVIDERS=google-drive,microsoft-onedrive,microsoft-sharepoint,gmail,outlook

# Only used by the nango-server/nango-jobs containers in docker-compose,
# not read by the backend directly, but required for `docker compose up`.
# Generate with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=
NANGO_DASHBOARD_USERNAME=admin
# Generate with: openssl rand -hex 20
NANGO_DASHBOARD_PASSWORD=
