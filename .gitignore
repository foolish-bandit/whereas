# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Virtualenvs
.venv/
venv/
env/

# Editor
.idea/
.vscode/
*.swp
.DS_Store

# Node (frontend has its own .gitignore for its node_modules; this
# catches stray top-level caches that some toolchains create when
# invoked from the repo root by accident — e.g. `node_modules/.vite`
# from a vitest run launched outside `frontend/`.)
node_modules/

# Environment files (secrets)
.env
.env.local

# Local developer runtime state
.local/
