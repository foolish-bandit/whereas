# Whereas frontend — copy to .env.local and adjust as needed.

# Backend API base URL. Defaults to http://localhost:8000 in dev. Ignored
# when VITE_WHEREAS_DEMO_MODE=true.
VITE_API_BASE_URL=http://localhost:8000

# Demo / preview mode. When set to "true", the frontend uses in-memory
# mock data instead of calling the backend. Useful for hosted UI previews
# (e.g. Cloudflare Pages) where no backend is available.
#
# Set to "true" to enable. Anything else (or absent) keeps real-API mode.
# VITE_WHEREAS_DEMO_MODE=true
